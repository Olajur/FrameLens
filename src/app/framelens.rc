#include <winuser.h>
#include <winver.h>

// The first icon resource is what Explorer, shortcuts and the installer show for framelens.exe.
// Generated by tools/icon/make_icon.py (same design the app draws for its window and tray icon).
1 ICON "framelens.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "framelens.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,3,2,0
PRODUCTVERSION 0,3,2,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "FrameLens"
            VALUE "FileDescription", "FrameLens FPS and hardware monitor"
            VALUE "FileVersion", "0.3.2"
            VALUE "InternalName", "framelens"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "framelens.exe"
            VALUE "ProductName", "FrameLens"
            VALUE "ProductVersion", "0.3.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
